<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>Homepage: verification instructions link + modal (for the reviewer)</name>
  <code>ecoplastics_check_instructions</code>
  <author>ecoplastics</author>
  <version>1.0.0</version>
  <link>https://ecoplastics.telbot-test.space/</link>
  <file path="catalog/controller/common/home.php">
    <operation>
      <search><![CDATA[$data['header'] = $this->load->controller('common/header');]]></search>
      <add position="after"><![CDATA[

		// Reviewer-facing "how to check this" instructions, kept as plain
		// HTML in a separate file so the text can be edited without touching
		// any PHP/template code.
		$check_instructions_file = dirname(DIR_APPLICATION) . '/check-instructions.txt';
		$data['check_instructions'] = is_file($check_instructions_file) ? file_get_contents($check_instructions_file) : '';

		$check_readme4_file = dirname(DIR_APPLICATION) . '/check-instructions-level4-readme.txt';
		$data['check_readme_level4'] = is_file($check_readme4_file) ? file_get_contents($check_readme4_file) : '';]]></add>
    </operation>
  </file>
  <file path="catalog/view/theme/default/template/common/home.twig">
    <operation>
      <search><![CDATA[{{ header }}]]></search>
      <add position="after"><![CDATA[
<a href="#" class="ecp-check-link" id="ecp-check-link">Інструкція з перевірки</a>

<div class="ecp-check-overlay" id="ecp-check-overlay">
  <div class="ecp-check-modal">
    <button class="ecp-check-close" id="ecp-check-close" aria-label="Закрити">&times;</button>

    <div id="ecp-check-main">
      <h2>Як перевірити тестове завдання</h2>
      {{ check_instructions }}
    </div>

    <div id="ecp-check-readme4" style="display:none">
      <a href="#" class="ecp-check-back" onclick="ecpShowMain(event)">&larr; Назад</a>
      <h2>Рівень 4 — Модуль доставки "Нова Пошта"</h2>
      {{ check_readme_level4 }}
    </div>
  </div>
</div>

<style>
  .ecp-check-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #828282;
    background: #fff;
    text-decoration: none;
    border-bottom-right-radius: 6px;
    transition: color .15s;
  }

  .ecp-check-link:hover { color: #000; }

  .ecp-check-overlay {
    position: fixed;
    top: 0; right: 0; bottom: 0; left: 0;
    z-index: 10001;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
  }

  .ecp-check-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .ecp-check-modal {
    background: #fff;
    border-radius: 12px;
    max-width: 640px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 40px;
    position: relative;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    transform: scale(0.96);
    transition: transform .2s ease;
  }

  .ecp-check-overlay.open .ecp-check-modal { transform: scale(1); }

  .ecp-check-modal h2 { font-size: 26px; font-weight: 700; margin: 0 0 20px; color: #111; }
  .ecp-check-modal h3 { font-size: 17px; font-weight: 600; margin: 20px 0 8px; color: #111; }
  .ecp-check-modal h3:first-of-type { margin-top: 0; }
  .ecp-check-modal h4 { font-size: 15px; font-weight: 600; margin: 16px 0 6px; color: #111; }
  .ecp-check-modal p { font-size: 14px; line-height: 1.6; color: #333; margin: 0 0 8px; }
  .ecp-check-modal p:last-child { margin-bottom: 0; }
  .ecp-check-modal a { color: #000; }
  .ecp-check-modal ul,
  .ecp-check-modal ol {
    margin: 0 0 8px;
    padding-left: 20px;
  }
  .ecp-check-modal li {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
    margin-bottom: 6px;
  }
  .ecp-check-modal code {
    background: #f5f5f5;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 13px;
  }

  .ecp-check-back {
    display: inline-block;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .ecp-check-back:hover { text-decoration: underline; }

  .ecp-check-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
    color: #828282;
  }

  .ecp-check-close:hover { color: #000; }
</style>
<script>
  function ecpShowReadme4(e) {
    if (e) e.preventDefault();
    document.getElementById('ecp-check-main').style.display = 'none';
    document.getElementById('ecp-check-readme4').style.display = 'block';
  }
  function ecpShowMain(e) {
    if (e) e.preventDefault();
    document.getElementById('ecp-check-readme4').style.display = 'none';
    document.getElementById('ecp-check-main').style.display = 'block';
  }

  (function() {
    var link = document.getElementById('ecp-check-link');
    var overlay = document.getElementById('ecp-check-overlay');
    var closeBtn = document.getElementById('ecp-check-close');

    function open(e) {
      if (e) e.preventDefault();
      overlay.classList.add('open');
    }
    function close() {
      overlay.classList.remove('open');
      ecpShowMain();
    }

    link.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>
]]></add>
    </operation>
  </file>
</modification>
