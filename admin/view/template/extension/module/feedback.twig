{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-feedback" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-feedback" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_feedback_status" id="input-status" class="form-control">
                <option value="1" {% if module_feedback_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not module_feedback_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <h4 class="col-sm-offset-2">{{ text_group_salesdrive }}</h4>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-key">
              <span data-toggle="tooltip" title="{{ help_api_key }}">{{ entry_api_key }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_api_key" value="{{ module_feedback_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-submit-url">
              <span data-toggle="tooltip" title="{{ help_submit_url }}">{{ entry_submit_url }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_submit_url" value="{{ module_feedback_submit_url }}" placeholder="https://your-account.salesdrive.me/handler/" id="input-submit-url" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-list-url">
              <span data-toggle="tooltip" title="{{ help_list_url }}">{{ entry_list_url }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_list_url" value="{{ module_feedback_list_url }}" placeholder="https://your-account.salesdrive.me/api/order/list/" id="input-list-url" class="form-control" />
            </div>
          </div>

          <h4 class="col-sm-offset-2">{{ text_group_dilovod }}</h4>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-dilovod-api-url">{{ entry_dilovod_api_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_dilovod_api_url" value="{{ module_feedback_dilovod_api_url }}" placeholder="https://api.dilovod.ua" id="input-dilovod-api-url" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-dilovod-api-key">{{ entry_dilovod_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_dilovod_api_key" value="{{ module_feedback_dilovod_api_key }}" placeholder="{{ entry_dilovod_api_key }}" id="input-dilovod-api-key" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-dilovod-firm-id">{{ entry_dilovod_firm_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_dilovod_firm_id" value="{{ module_feedback_dilovod_firm_id }}" placeholder="{{ entry_dilovod_firm_id }}" id="input-dilovod-firm-id" class="form-control" />
            </div>
          </div>

          <h4 class="col-sm-offset-2">{{ text_group_telegram }}</h4>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tg-token">
              <span data-toggle="tooltip" title="{{ help_tg_token }}">{{ entry_tg_token }}</span>
            </label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_tg_token" value="{{ module_feedback_tg_token }}" placeholder="123456789:AA..." id="input-tg-token" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tg-chat-id">{{ entry_tg_chat_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_feedback_tg_chat_id" value="{{ module_feedback_tg_chat_id }}" placeholder="{{ entry_tg_chat_id }}" id="input-tg-chat-id" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-inbox"></i> {{ text_local_submissions }}</h3>
      </div>
      <div class="panel-body">
        <p>{{ text_local_pending|replace({'%d': local_pending}) }}</p>
        <div id="salesdrive-result"></div>
        <button type="button" id="btn-salesdrive" class="btn btn-success"><i class="fa fa-share-square-o"></i> {{ button_salesdrive }}</button>
      </div>
    </div>
{% if contacts_error %}
    <div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-triangle"></i> {{ contacts_error }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-users"></i> {{ text_contacts }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th style="width:50px">{{ column_id }}</th>
                <th>{{ column_name }}</th>
                <th>{{ column_phone }}</th>
              </tr>
            </thead>
            <tbody>
              {% if contacts %}
                {% for contact in contacts %}
                <tr>
                  <td>{{ loop.index }}</td>
                  <td>{{ contact.name }}</td>
                  <td>{{ contact.phone }}</td>
                </tr>
                {% endfor %}
              {% else %}
                <tr><td colspan="3" class="text-center">{{ text_no_contacts }}</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div id="dilovod-result"></div>
    <div id="dilovod-debug" style="display:none" class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-code"></i> {{ text_dilovod_debug }}</h3></div>
      <div class="panel-body">
        <pre id="dilovod-debug-body" style="max-height:300px;overflow-y:auto;font-size:12px;margin:0"></pre>
      </div>
    </div>
    <div class="text-right">
      <button type="button" id="btn-dilovod" class="btn btn-success"><i class="fa fa-share-square-o"></i> {{ button_dilovod }}</button>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var dilovod = {
    url:   {{ ajax_dilovod | json_encode }},
    sent:  {{ text_dilovod_sent | json_encode }},
    error: {{ text_dilovod_error | json_encode }}
};
var salesdrive = {
    url:   {{ ajax_salesdrive | json_encode }},
    sent:  {{ text_salesdrive_sent | json_encode }},
    empty: {{ text_salesdrive_empty | json_encode }},
    error: {{ text_salesdrive_error | json_encode }}
};
$(document).ready(function() {
    $('#btn-salesdrive').on('click', function() {
        var $btn = $(this).prop('disabled', true);
        var $res = $('#salesdrive-result');
        $res.html('');
        $.ajax({
            url: salesdrive.url,
            type: 'post',
            dataType: 'json',
            success: function(json) {
                if (json.error) {
                    $res.html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json.error + '</div>');
                    return;
                }
                if (json.empty) {
                    $res.html('<div class="alert alert-info"><i class="fa fa-info-circle"></i> ' + salesdrive.empty + '</div>');
                    return;
                }
                var msg = salesdrive.sent.replace('%d', json.sent);
                var cls  = json.errors.length ? 'alert-warning' : 'alert-success';
                var icon = json.errors.length ? 'fa-exclamation-triangle' : 'fa-check-circle';
                if (json.errors.length) {
                    msg += '<br>' + json.errors.join('<br>');
                }
                $res.html('<div class="alert ' + cls + '"><i class="fa ' + icon + '"></i> ' + msg + '</div>');
            },
            error: function(xhr) {
                $res.html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + salesdrive.error + ' (HTTP ' + xhr.status + ')</div>');
            },
            complete: function() {
                $btn.prop('disabled', false);
            }
        });
    });
    $('#btn-dilovod').on('click', function() {
        var $btn = $(this).prop('disabled', true);
        var $res = $('#dilovod-result');
        $res.html('');
        $('#dilovod-debug').hide();
        $.ajax({
            url: dilovod.url,
            type: 'post',
            dataType: 'json',
            success: function(json) {
                if (json.error) {
                    $res.html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json.error + '</div>');
                    return;
                }
                var msg = dilovod.sent.replace('%d', json.sent);
                var cls  = json.errors.length ? 'alert-warning' : 'alert-success';
                var icon = json.errors.length ? 'fa-exclamation-triangle' : 'fa-check-circle';
                if (json.errors.length) {
                    msg += '<br>' + json.errors.join('<br>');
                }
                $res.html('<div class="alert ' + cls + '"><i class="fa ' + icon + '"></i> ' + msg + '</div>');
                if (json.raw && json.raw.length) {
                    var lines = json.raw.map(function(r) {
                        var pretty = r.response;
                        try { pretty = JSON.stringify(JSON.parse(r.response), null, 2); } catch(e) {}
                        return '--- ' + r.name + ' ---\n' + pretty;
                    });
                    $('#dilovod-debug-body').text(lines.join('\n\n'));
                    $('#dilovod-debug').show();
                }
            },
            error: function(xhr) {
                $res.html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + dilovod.error + ' (HTTP ' + xhr.status + ')</div>');
                if (xhr.responseText) {
                    var pretty = xhr.responseText;
                    try { pretty = JSON.stringify(JSON.parse(xhr.responseText), null, 2); } catch(e) {}
                    $('#dilovod-debug-body').text('HTTP ' + xhr.status + '\n\n' + pretty);
                    $('#dilovod-debug').show();
                }
            },
            complete: function() {
                $btn.prop('disabled', false);
            }
        });
    });
});
//--></script>
{{ footer }}
